# FixFlow environment. Copy to .env for docker compose. Values below are DEV PLACEHOLDERS only;
# never reuse them outside local development.

# --- Postgres (db service) ---
POSTGRES_USER=fixflow
POSTGRES_PASSWORD=fixflow-dev-password   # DEV ONLY placeholder
POSTGRES_DB=fixflow
# Host port published for the db container (container port is always 5432).
DB_PORT=5432

# --- Backend (backend service) ---
# Host port published for the API (container port is always 8000).
API_PORT=8000
# Used by the app when run outside compose. Inside compose it is derived from the POSTGRES_* vars.
DATABASE_URL=postgresql+psycopg://fixflow:fixflow-dev-password@localhost:5432/fixflow
# Used by pytest only; the database name MUST contain "test" (created by backend/db-init).
TEST_DATABASE_URL=postgresql+psycopg://fixflow:fixflow-dev-password@localhost:5432/fixflow_test
# development | test | production
ENVIRONMENT=development
# Comma-separated allowed browser origins (no wildcard).
CORS_ORIGINS=http://localhost:3000
UPLOAD_DIR=/data/uploads
SESSION_TTL_MINUTES=720
LOG_LEVEL=INFO
MAX_PAGE_SIZE=100
DEFAULT_PAGE_SIZE=20
MAX_UPLOAD_BYTES=10485760
# Server-Sent Events (live updates)
STREAM_TICKET_TTL_SECONDS=60
STREAM_HEARTBEAT_SECONDS=15
STREAM_REVALIDATE_SECONDS=30
STREAM_QUEUE_SIZE=100

# --- Web (web service) ---
# Host port published for the web app (container port is always 3000).
WEB_PORT=3000
# API base URL as seen from the BROWSER; baked into the web bundle at build time (rebuild after changing).
NEXT_PUBLIC_API_URL=http://localhost:8000
# NOTE: if WEB_PORT is changed, add the new origin to CORS_ORIGINS (e.g. http://localhost:3001).
